      "id": "h10",
      "category": "REASONING",
      "question": "Which single product sold the most units between April 1 and June 30, 2026, not counting cancelled orders?",
      "expected_tools": [
        "query_database"
      ],
      "truth": [
        {
          "check": "names",
          "sql": "WITH q AS (SELECT p.name, sum(oi.quantity) AS units FROM order_items oi JOIN orders o ON o.id = oi.order_id JOIN products p ON p.id = oi.product_id WHERE o.status <> 'cancelled' AND o.order_date BETWEEN '2026-04-01' AND '2026-06-30' GROUP BY p.name) SELECT name FROM q WHERE units = (SELECT max(units) FROM q)"
        }
      ],
      "must_mention": [
        [
          "tie",
          "tied",
          "same number",
          "equal",
          "each sold",
          "all sold",
          "joint",
          "three products"
        ]
      ],
      "max_tool_calls": 3
