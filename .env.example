# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lookup_db

# LLM keys (dev uses Groq, live demo uses OpenAI)
GROQ_API_KEY=
OPENAI_API_KEY=

# Tracing (Langfuse), filled in at the tracing phase
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# App
LOG_LEVEL=INFO