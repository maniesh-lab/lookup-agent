# Database (owner user: used for setup, seeding, search and conversation memory)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lookup_db
# Read-only user for the agent's SQL tool (created by db/schema.sql)
READONLY_DATABASE_URL=postgresql://lookup_reader:lookup_reader@localhost:5432/lookup_db

# LLM keys. Groq is free and the default; OpenAI is optional. The provider
# that isn't LLM_PROVIDER becomes the fallback when its key is set.
# LLM_MODEL is the Groq model, OPENAI_MODEL the OpenAI one.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
OPENAI_API_KEY=

# Agent
PROMPT_VERSION=v2
MAX_AGENT_STEPS=6

# Search: vector, hybrid or rerank
SEARCH_MODE=rerank

# Tracing (Langfuse). Leave the two keys empty to switch tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
LOG_LEVEL=INFO
# If set, POST /ingest needs the header X-Ingest-Token with this value
INGEST_TOKEN=
# If set, POST /chat needs the header X-API-Key with this value. Leave empty
# for the chat page and local use (the page has no way to send a key).
CHAT_API_KEY=
# Questions per client IP in any 60 seconds; 0 turns the limit off. Kept in
# memory: resets on restart, counts per server process, and behind a reverse
# proxy needs uvicorn --forwarded-allow-ips=<proxy address> to see real client IPs.
CHAT_RATE_LIMIT_PER_MINUTE=20
